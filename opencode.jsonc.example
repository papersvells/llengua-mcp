{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "llengua": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/papersvells/llengua-mcp.git",
          "llengua-mcp"
        ],
        "environment": {
          "LLENGUA_USER_AGENT": "llengua-mcp/0.1"
        },
        "timeout": { "execution": 60000 },
        "codemode": false
      }
    }
  }
}
